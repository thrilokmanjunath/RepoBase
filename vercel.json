{
  "version": 2,
  "builds": [
    {
      "src": "repobase_project/repobase_project/wsgi.py",
      "use": "@vercel/python"
    },
    {
      "src": "repobase_project/static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/repobase_project/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "repobase_project/repobase_project/wsgi.py"
    }
  ]
}
